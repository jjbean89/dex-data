# --- Required ---
DATABASE_URL=postgres://dex:dex@localhost:5432/dexdata

# --- Process role: all | collector | api (default: all) ---
# On Railway, run two services from this repo: one with ROLE=collector, one with ROLE=api.
ROLE=all

# --- API server (Railway injects PORT automatically) ---
PORT=3000
HOST=0.0.0.0

# --- Hyperliquid ---
HL_API_URL=https://api.hyperliquid.xyz

# --- Collector tuning ---
# How often to snapshot metaAndAssetCtxs (all coins in one request). 15s ≈ 80 weight/min of the 1200/min IP budget.
POLL_INTERVAL_MS=15000
# Settled funding sync: how often to sweep fundingHistory for every coin, and pacing between requests.
FUNDING_SYNC_INTERVAL_MS=3600000
FUNDING_REQ_DELAY_MS=2000
# On first run, how far back to backfill settled funding. HL has data back to May 2023 —
# set e.g. 1200 to pull everything (the paced sweep will chip away at it).
FUNDING_BACKFILL_DAYS=30
# Rollup job cadence (builds 5m/1h candles from raw ticks).
ROLLUP_INTERVAL_MS=60000
# Retention: raw ticks and 5m candles are pruned; 1h candles are kept forever.
RAW_RETENTION_DAYS=14
CANDLES_5M_RETENTION_DAYS=180

# --- EMA tracker ---
# Maintains EMA(period) per coin per timeframe from HL's official candles and
# serves them via GET /v1/perps/emas. Each (coin, timeframe) is seeded once from
# full candle history (matching TradingView's ta.ema), then kept current with
# one hourly-candle request per coin per hour.
EMAS_ENABLED=true
# Any of: 1h, 2h, 4h, 8h, 12h, 1d
EMA_TIMEFRAMES=1h,4h,12h,1d
EMA_PERIODS=21,200
# Pacing between candleSnapshot requests (weight 20 each; 2000ms ≈ 600 weight/min).
EMA_REQ_DELAY_MS=2000
# Every N days each coin is re-seeded from full history (drift self-heal); 0 disables.
EMA_RESEED_DAYS=7

# --- Long/short trader tracking ---
# Discovers wallets from the trades WebSocket, bootstraps their positions via
# clearinghouseState, and snapshots per-coin long/short counts on an interval.
POSITIONS_ENABLED=true
HL_WS_URL=wss://api.hyperliquid.xyz/ws
# Buffered fill-delta write cadence. Snapshots are minutes apart, so a few seconds
# of buffering costs no fidelity and cuts write transactions ~5x.
POSITIONS_FLUSH_MS=5000
# Pacing between clearinghouseState lookups (weight 2 each; 400ms ≈ 300 weight/min).
BOOTSTRAP_DELAY_MS=400
# Long/short snapshot cadence (the resolution of the change-over-time series).
POSITIONS_SNAPSHOT_MS=300000
# Slow self-heal: every interval, re-baseline the longest-unverified active wallets.
REVERIFY_INTERVAL_MS=21600000
REVERIFY_BATCH=2000

# --- HyperTracker census seed (optional) ---
# With a key set, the collector runs a one-time import of every open position per
# coin from HyperTracker (docs.coinmarketman.com) — an instant starting census that
# includes wallets that predate this service. Imports are provisional and get
# re-verified wallet-by-wallet against Hyperliquid's clearinghouseState.
# Resumable per coin; to force a full re-import: delete from seed_progress;
HYPERTRACKER_API_KEY=
HYPERTRACKER_BASE_URL=https://ht-api.coinmarketman.com/api
HYPERTRACKER_REQ_DELAY_MS=1500
# Retry cadence for incomplete imports (quota windows pass without redeploys).
HYPERTRACKER_RETRY_MS=10800000
# Deep archive (opt-in): walk each coin's full paginated position-metrics series
# back to the start date below (~15-min samples; request-hungry — on the free
# tier this chips away daily for weeks, on a paid tier it completes in hours).
# Day-to-day change tracking does NOT need this — live snapshots cover it.
HYPERTRACKER_DEEP_HISTORY=false
HYPERTRACKER_DEEP_START=2025-04-04T00:00:00Z

# --- Postgres TLS ---
# Set to true only if your provider requires TLS but presents a self-signed cert
# (e.g. connecting to Railway Postgres over the public proxy). Not needed on Railway's private network.
PG_SSL_NO_VERIFY=false
