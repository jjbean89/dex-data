# --- Required ---
DATABASE_URL=postgres://dex:dex@localhost:5432/dexdata

# --- Process role: all | collector | api (default: all) ---
# On Railway, run two services from this repo: one with ROLE=collector, one with ROLE=api.
ROLE=all

# --- API server (Railway injects PORT automatically) ---
PORT=3000
HOST=0.0.0.0

# --- Hyperliquid ---
HL_API_URL=https://api.hyperliquid.xyz

# --- Collector tuning ---
# How often to snapshot metaAndAssetCtxs (all coins in one request). 15s ≈ 80 weight/min of the 1200/min IP budget.
POLL_INTERVAL_MS=15000
# Settled funding sync: how often to sweep fundingHistory for every coin, and pacing between requests.
FUNDING_SYNC_INTERVAL_MS=3600000
FUNDING_REQ_DELAY_MS=2000
# On first run, how far back to backfill settled funding. HL has data back to May 2023 —
# set e.g. 1200 to pull everything (the paced sweep will chip away at it).
FUNDING_BACKFILL_DAYS=30
# Rollup job cadence (builds 5m/1h candles from raw ticks).
ROLLUP_INTERVAL_MS=60000
# Retention: raw ticks and 5m candles are pruned; 1h candles are kept forever.
RAW_RETENTION_DAYS=14
CANDLES_5M_RETENTION_DAYS=180

# --- Postgres TLS ---
# Set to true only if your provider requires TLS but presents a self-signed cert
# (e.g. connecting to Railway Postgres over the public proxy). Not needed on Railway's private network.
PG_SSL_NO_VERIFY=false
